VARS EXSTR EXCTR EXCTR1 EXPRF EXSYM NSEX;
FUNCTI EXREP;
A:IF EXCTR>NSEX THEN 94 EXIT;
IF EXPRF THEN SUBSCC(EXCTR,EXSTR)->EXSYM;EXCTR+1->EXCTR;
IF EXSYM=10 THEN 0->EXPRF CLOSE;
 EXSYM ELSE
 IF SUBSCC(EXCTR,EXSTR)=10 THEN 10.CUCHOU;EXCTR+1->EXCTR;GOTO A CLOSE;
EXCTR->EXCTR1;58.CUCHOU;1->EXPRF;
LOOPIF(SUBSCC(EXCTR1,EXSTR)->EXSYM;EXCTR1+1->EXCTR1;EXSYM.CUCHOU;EXSYM/=10)
 THEN CLOSE;
GOTO A CLOSE END;
FUNCTI EXPAБ;
->EXSTR;
1->EXCTR;0->EXPRF;
DATALE(EXSTR)->NSEX;
COMPIL(EXREP)
END;
MACRO MXCOЗД;
 VARS N;.ITEMRE->N;1.SP;N.PR;
 MACRES([%"VARS","MACRO",N,";","EXPAБ","(%",.ITEMRE,"%)","->","NONMAC",N,";"%])
END;
PRSTRI('ДЛЯ BЫЗOBA ПPИMEPA HAБEPИTE EГO HAЗBAHИE
  ИMEЮTCЯ CЛEДYЮЩИE ПPИMEPЫ:');1.NL;MXCOЗД APИФM'
2*2=>
5*(6+3*3)-1=>
40/3=> 40//3=>
3, 2*2, SIN(1), EXP(LOG(2!3)/3) =>
'
MXCOЗД ПEPEM'
VARS X Y Z;
1->X; SIN->Y; Y(X)=>
2->Z; X,Z=>
X,Z->X->Z; X,Z=>
'MXCOЗД ФYHKЦИ'
COMMENT ФYHKЦИЯ TRANSLATE ПEЧATAET ЧИCЛO A B CИCTEME CЧИCЛEHИЯ C OCHOBAHИEM N;
FUNCTION OUT X;
  IF X<10 THEN 48 ELSE 55 CLOSE +X; .CUCHOUT
END;
FUNCTION TRANSLATE A N; VARS U; 0->U;
  LOOPIF(A//N->A; U+1->U; A/=0) THEN CLOSE;
  LOOPIF U THEN .OUT; U-1->U CLOSE
END;
TRANSLATE(92,16); COMMENT ЧИCЛO 92 B ШECTHAДЦATEPИЧHOЙ CИCTEME;

TRANSLATE(100,2);

'
MXCOЗД APPL'
COMMENT ФYHKЦИЯ APPLIST ПPИMEHЯET ЗAДAHHYЮ ФYHKЦИЮ KO BCEM ЭЛEMEHTAM CПИCKA.
ФYHKЦИЯ MAPLIST ДEЛAET TO ЖE, HO ИЗ ПOЛYЧEHHЫX PEЗYЛЬTATOB OБPAЗYET CПИCOK;
APPLIST([1 2 3 4],SQRT)=>
MAPLIST([1 2 3 4],SQRT)=>
APPLIST([1 2 3 4],PR);

'MXCOЗД APPD'
COMMENT ФYHKЦИЯ APPDATA ПPИMEHЯET ЗAДAHHYЮ ФYHKЦИЮ KO BCEM KOMПOHEHTAM
CTPYKTYPЫ ДAHHЫX (CTPИПA ИЛИ ЗAПИCИ);
VARS I ST; INIT(4)->ST; FORALL I 1 1 4 I->SUBSCR(I,ST) CLOSE;
APPDATA(ST,PR);

APPDATA(ST,SQRT)=>
'

APИФM;
ПEPEM;
ФYHKЦИ;
APPL;
APPD;
