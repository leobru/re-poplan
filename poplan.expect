#!/usr/bin/expect --
#
# Play the POPLAN tic-tac-toe game.
# Usage:
#	poplan.expect
#
if { $::argc != 0 } {
	puts "Usage:\n\t$::argv0"
	exit 0
}

set timeout 10

#
# Start POPLAN with Latin terminal output.
#
spawn dispak -l --bootstrap -q poplan.b6
expect 	"*2.1*\r\n:"

#
# Start the game stored on the historical disk.
#
send	{[% "MI", 8:421220, 0, 8:421221, 1023 %].popmess.compile;}
send	"\r"
expect 	"TO ENTER PROGRAM, TYPE  FOURS;\r\n:"
send	"FOURS;\r"

expect 	"DO YOU KNOW HOW TO PLAY AGAINST THIS PROGRAM\r\n:"
send	"YES\r"
expect 	"DO YOU WANT TO START\r\n:"
send	"YES\r"

expect 	"YOUR MOVE\r\n:"
send	"0 0 0\r"
expect 	"YOUR MOVE\r\n:"
send	"1 1 1\r"

expect 	"YOUR MOVE\r\n:"
send	"RESIGN\r"
expect 	"DO YOU WANT TO PLAY AGAIN\r\n:"
send	"NO\r"
expect 	"BACK TO POP2 THEN\r\n:"

#
# Terminate POPLAN.
#
send	"^\r"
expect	eof
puts ""
