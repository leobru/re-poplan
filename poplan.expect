#!/usr/bin/expect --
#
# Игра на Поплане.
# Вызов:
#	poplan.expect
#
if { $::argc != 0 } {
	puts "Usage:\n\t$::argv0"
	exit 0
}

#
# Запускаем Поплан.
#
spawn dispak -q poplan.b6
expect 	"ПОПЛАН*\r\n:"

#
# Запускаем игру.
#
send	{[% "MI", 8:421220, 0, 8:421221, 1023 %].popmess.compile;}
send	"\r"
expect 	"ТО ЕNТЕR РRОGRАМ, ТУРЕ  FОURS;\r\n:"
send	"FOURS;\r"

expect 	"DО УОU КNОW НОW ТО РLАУ АGАINSТ ТНIS РRОGRАМ\r\n:"
send	"н\r"
expect 	"\r\n:\r"

#
# Завершаем работу.
#
puts ""
