VARS X Y COUNT PREV;
9->X;8->Y;0->COUNT;
FUNCTION CONST; 7 END;
CONST()=>
FUNCTI F X Y; X*10+Y END;
F(2,3)=>
X,Y=>
FUNCTI LOCAL X; VARS Y; Y=> X+1->Y; Y END;
LOCAL(4)=>
X,Y=>
FUNCTI EARLY X; IF X THEN 7; RETURN CLOSE; 8 END;
EARLY(TRUE)=>
EARLY(FALSE)=>
FUNCTI EMPTY; END;
EMPTY()=>
FUNCTI MULTI X; X; X+1 END;
MULTI(3)=>
FUNCTI TRI N; IF N=0 THEN 0 ELSE N+TRI(N-1) CLOSE END;
TRI(20)=>
FUNCTI FAC N; IF N=0 THEN 1 ELSE N*FAC(N-1) CLOSE END;
FAC(8)=>
FUNCTI NEXT; COUNT+1->COUNT; COUNT END;
F(NEXT(),NEXT())=>
COUNT=>
FUNCTI INNER; X END;
FUNCTI OUTER X; INNER()+1 END;
OUTER(5)=>
X=>
CONST->PREV; F(1,2,3)=>
FUNCTI CONST; 11 END;
CONST()=>
PREV=CONST=>
PREV=PREV=>
PREV()=>
FUNCTI RECUR N; VARS Y; N->Y; IF N=0 THEN Y ELSE RECUR(N-1)+Y CLOSE END;
RECUR(15)=>
Y=>
CONST=>
