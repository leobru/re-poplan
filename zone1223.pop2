FUNCTI ASSOCVAL X ROTE EQUIV N;
VARS P PO U;
SUBSCR(N+1,ROTE)->P;P->PO;
L1: SUBSCR(P,ROTE)->U;
    IF EQUIV(X,FRONT(U)) THEN BACK(U);
          IF P/=PO THEN P-1->PO;
                IF PO=0 THEN N->PO;CLOSE;
                SUBSCR(PO,ROTE),U ->SUBSCR(PO,ROTE);
                ->SUBSCR(P,ROTE);
        CLOSE;
   EXIT;
P+1->P;
IF P>N THEN 1->P;CLOSE;
IF P=PO OR FRONT(U)=UNDEF THEN UNDEF EXIT;
GOTO L1;
END;
FUNCTI ASSOCUD Y X ROTE N;
VARS P U;
SUBSCR(N+1,ROTE)->P;
IF P=1 THEN N->P;ELSE P-1->P;CLOSE;
X->FRONT(SUBSCR(P,ROTE));
Y->BACK(SUBSCR(P,ROTE));
P->SUBSCR(N+1,ROTE);
END;
  
FUNCTI NEWASSOCFN N EQUIV;
VARS U V N1;
INIT(N+1)->U;
1->SUBSCR(N+1,U);1->N1;
L1: IF N1=<N THEN UNDEF::UNDEF->SUBSCR(N1,U);N1+1->N1;
    GOTO L1;CLOSE;
ASSOCVAL(% U,EQUIV,N %)->V;
ASSOCUD(% U,N %)->UPDATER(V);   V;
END;
       
FUNCTI DOMEMO X F A;
VARS Y;A(X)->Y;
IF F.FNPROPS.TL.HD THEN IF Y=UNDEF THEN 0->F.FNPROPS.TL.HD;
X.F->Y;Y->A(X);
1->F.FNPROPS.TL.HD; CLOSE;
Y; ELSE IF Y=UNDEF THEN F(X) ELSE Y; CLOSE ;CLOSE;
END;
     
FUNCTI NEWMEMO F N EQUIV;
VARS U V;
   IF F.FNPROPS.ATOM THEN F.FNPROPS::NIL->F.FNPROPS;CLOSE;
    [% 1,TL(FNPROPS(F)) %]->TL(FNPROPS(F));
    NEWASSOCFN(N,EQUIV)->U;
    DOMEMO(% F,U %)->V;
    UPDATER(U)->UPDATER(V);
IF V.FNPROPS.ATOM THEN V.FNPROPS::NIL->V.FNPROPS CLOSE;
  "MEMO"::TL(FNPROPS(V))->TL(FNPROPS(V));   V;
END;
     
FUNCTI ISMEMO F;
IF F.FNPROPS.ATOM THEN FALSE EXIT;
IF F.FNPROPS.TL.NULL THEN FALSE EXIT;
  F.FNPROPS.TL.HD="MEMO"
END;
      
FUNCTI UNMEMO F;  VARS MF;
IF F.ISMEMO THEN 
   FROZVAL(1,F)->MF;
  IF MF.FNPROPS.TL.NULL.NOT THEN
    TL(TL(FNPROPS(MF)))->TL(FNPROPS(MF));
  CLOSE;MF;
ELSE UNDEF;
CLOSE;END;
     
FUNCTI DICTOF F;
IF F.ISMEMO THEN FROZVAL(1,FROZVAL(2,F))ELSE UNDEF CLOSE;
END;
     
FUNCTI PRDICTOF F;
VARS P P1 N STRIP;
F.DICTOF->STRIP;
1.NL;IF STRIP=UNDEF THEN UNDEF.PR;EXIT;
FROZVAL(3,FROZVAL(2,F)) ->N;
SUBSCR(N+1,STRIP)->P;1->P1;
L1: IF HD(SUBSCR(P,STRIP))=UNDEF THEN EXIT;
PR(FRONT(SUBSCR(P,STRIP)));PR(BACK(SUBSCR(P,STRIP)));
1.NL;P+1->P;P1+1->P1;
IF P1>N THEN EXIT ;
IF P>N THEN 1->P;CLOSE;
GOTO L1;
END;
     
2.NL;'MEMOFNS READY FOR USE'.PR;2.NL;
