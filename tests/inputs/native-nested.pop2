VARS F G B X;
77->B; 99->X;
FUNCTI GETB; B; END;
FUNCTI OUTER X;
 B=>
 FUNCTI B; X+1->X; X; END;
 GETB()=B=>
 B()=>
 B;
END;
OUTER(12)->F;
B=>
X=>
OUTER(34)->G;
F=G=>
F()=>
X=>
FUNCTI USE X; F(); X; END;
USE(23)=>
X=>
FUNCTI OTHER X;
 FUNCTI B; X+2; END;
 B;
END;
F=OTHER(6)=>
FUNCTI DEEP X;
 FUNCTI MID Y;
  FUNCTI LEAF Z; X+Y+Z; END;
  LEAF(3);
 END;
 MID(2);
END;
DEEP(10)=>
FUNCTI SHADOW X;
 FUNCTI B X; X+1; END;
 B(5); X;
END;
SHADOW(20)=>
X=>
FUNCTI TRI N;
 FUNCTI NEXT; N+TRI(N-1); END;
 IF N=0 THEN 0 ELSE NEXT() CLOSE;
END;
TRI(10)=>
B=>
