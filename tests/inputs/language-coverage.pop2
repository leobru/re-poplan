COMMENT POP-2 REFERENCE LANGUAGE COVERAGE;

8:10+2:10=>
12.0+2.5*(1.5+2.5)=>

VARS A B SUM;
2*2->A;
3*A->B;
A*A+B*B->SUM;
SUM=>

FUNCTION SUMSQ X Y;
  X*X+Y*Y
END;
SUMSQ(A,B)+1=>

FUNCTION FACT N;
  VARS P;
  1->P;
LOOP: IF N=0 THEN P; RETURN CLOSE;
  N*P->P;
  N-1->N;
  GOTO LOOP
END;
FACT(6)=>

FUNCTION EARLY X;
  IF X THEN 7 EXIT;
  8
END;
EARLY(TRUE)=>
EARLY(FALSE)=>

IF FALSE OR TRUE AND TRUE
  THEN 2
  ELSEIF TRUE THEN 3
  ELSE 4
CLOSE=>
IF FALSE
  THEN 2
  ELSEIF TRUE THEN 3
  ELSE 4
CLOSE=>
IF FALSE
  THEN 2
  ELSEIF FALSE THEN 3
  ELSE 4
CLOSE=>

VARS OPERATION 5 PLUS;
NONOP + -> NONOP PLUS;
2 PLUS 3=>

VARS ADD2;
NONOP +(%2%)->ADD2;
ADD2(5)=>

'OK'=>
[1 2 DOG]=>
[%1,2+1%]=>

VARS ARRAY;
NEWARRAY([%1,2,1,2%],
  LAMBDA I J;I*10+J END)->ARRAY;
ARRAY(2,1)=>
99->ARRAY(1,2);
ARRAY(1,2)=>

VARS BSUB BINIT BITS;
STRIPFNS("BIT",1)->BSUB->BINIT;
BINIT(4)->BITS;
1->BSUB(2,BITS);
BSUB(2,BITS)=>

VARS PCONS PDEST PNAME PAGE PERSON;
RECORDFNS("PERSON",[%0,0%])
  ->PAGE->PNAME->PDEST->PCONS;
PCONS("ADA",36)->PERSON;
DATALIST(PERSON)=>
37->PAGE(PERSON);
DATALIST(PERSON)=>

MACRO DUP;
  VARS X;
  ITEMREAD()->X;
  MACRESULTS([%X,",",X%])
END;
DUP 5=>

VARS RUNTIME TEMP;
0->RUNTIME;
POPVAL([1 -> RUNTIME;GOON]);
RUNTIME=>
1->TEMP;
TEMP=>
CANCEL TEMP;
